generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(cuid())
  name         String?
  email        String   @unique
  passwordHash String
  createdAt    DateTime @default(now())

  plaidItems        PlaidItem[]
  financialAccounts FinancialAccount[]
  categories        Category[]
  transactions      Transaction[]
  merchantRules     MerchantRule[]
  incomeProfile     IncomeProfile?
  goals             Goal[]
}

/// One Plaid Item = one bank-login connection, which can expose several accounts.
model PlaidItem {
  id              String    @id @default(cuid())
  userId          String
  itemId          String    @unique
  accessToken     String
  institutionId   String?
  institutionName String?
  createdAt       DateTime  @default(now())
  /// Plaid's transactionsSync cursor, so re-syncing only fetches what changed since last time.
  syncCursor      String?
  lastSyncedAt    DateTime?

  user     User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  accounts FinancialAccount[]
}

model FinancialAccount {
  id               String  @id @default(cuid())
  userId           String
  plaidItemId      String?
  plaidAccountId   String?
  name             String
  mask             String?
  type             String
  subtype          String?
  currentBalance   Float?
  availableBalance Float?
  isoCurrencyCode  String  @default("USD")

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  plaidItem    PlaidItem?    @relation(fields: [plaidItemId], references: [id], onDelete: Cascade)
  transactions Transaction[]

  @@unique([plaidAccountId])
}

model Category {
  id              String  @id @default(cuid())
  userId          String
  parentId        String?
  name            String
  icon            String  @default("")
  monthlyLimit    Float?
  rolloverEnabled Boolean @default(false)

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  parent       Category?     @relation("CategoryToSubcategory", fields: [parentId], references: [id], onDelete: Cascade)
  children     Category[]    @relation("CategoryToSubcategory")
  transactions Transaction[]
  merchantRules MerchantRule[]
  goal         Goal?

  @@unique([userId, parentId, name])
}

/// A savings target attached to a leaf category (typically under "Goals"). Progress is
/// derived from that category's all-time transaction total, not stored redundantly here.
model Goal {
  id           String    @id @default(cuid())
  userId       String
  categoryId   String    @unique
  targetAmount Float
  targetDate   DateTime?
  createdAt    DateTime  @default(now())

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  category Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
}

model Transaction {
  id                 String   @id @default(cuid())
  userId             String
  financialAccountId String
  categoryId         String?
  plaidTransactionId String?  @unique
  amount             Float
  isoCurrencyCode    String   @default("USD")
  date               DateTime
  name               String
  merchantName       String?
  pending            Boolean  @default(false)
  createdAt          DateTime @default(now())

  user             User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  financialAccount FinancialAccount @relation(fields: [financialAccountId], references: [id], onDelete: Cascade)
  category         Category?        @relation(fields: [categoryId], references: [id], onDelete: SetNull)
}

/// Remembers which category a merchant was manually assigned to, so future (and existing)
/// transactions from the same merchant can be auto-categorized.
model MerchantRule {
  id         String   @id @default(cuid())
  userId     String
  matchKey   String
  categoryId String
  createdAt  DateTime @default(now())

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  category Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([userId, matchKey])
}

/// A user's declared pay schedule, used to project income and auto-set budgets
/// without waiting for months of actual transaction history to accumulate.
model IncomeProfile {
  id         String   @id @default(cuid())
  userId     String   @unique
  frequency  String
  amount     Float?
  variable   Boolean  @default(false)
  updatedAt  DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}
