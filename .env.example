# Postgres connection string (Neon/Supabase/RDS/etc.) — same one used in production.
DATABASE_URL=""

# Auth.js — generate with: npx auth secret
AUTH_SECRET=""

# Plaid — free sandbox signup at https://dashboard.plaid.com/signup
# PLAID_ENV must match whichever secret you use below:
#   "sandbox"    + sandbox secret    -> fake banks/data only
#   "production" + production secret -> real banks (requires Plaid production/trial access)
PLAID_CLIENT_ID=""
PLAID_SECRET=""
PLAID_ENV="sandbox"

# Gemini — free API key at https://aistudio.google.com/apikey
GEMINI_API_KEY=""
# Optional — defaults to gemini-2.5-flash if unset
GEMINI_MODEL=""
